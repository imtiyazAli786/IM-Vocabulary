# LexiCard Environment Variables
# Add your Gemini API key (or other LLM key) here
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Active AI model provider ('gemini' | 'mock' | 'claude' | 'openai')
EXPO_PUBLIC_AI_PROVIDER=gemini

# Optional Firebase configuration for multi-device sync
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
